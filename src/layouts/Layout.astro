---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
	bodyClass?: string;
}

const {
	title = 'Jacob Sides — Web Engineer & Creator',
	description = 'Jacob Sides is a full-stack web engineer and creator based in Chattanooga, Tennessee.',
	bodyClass = '',
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#0b0b1a" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Afacad+Flux:wght@400;500;600&family=Source+Sans+3:wght@600;700;800&display=swap"
			rel="stylesheet"
		/>
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body class={bodyClass}>
		<slot />
		<script>
			import posthog from 'posthog-js';

			posthog.init('phc_oLhpgvjeqoSyOjmXjcRkvRFOOtXuW0zRR5Oe3w12ivC', {
				api_host: 'https://app.posthog.com',
				capture_pageview: false,
				capture_pageleave: false,
			});
			posthog.capture('$pageview');
			window.addEventListener('pagehide', () => posthog.capture('$pageleave'), { once: true });
		</script>
	</body>
</html>
