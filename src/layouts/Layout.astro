---
import '../styles/global.css';

interface Props {
	title?: string;
}

const { title = 'jasi' } = Astro.props;
---

<!doctype html>
<html lang="en" class="h-full" data-mode="touch">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body class="h-full overflow-hidden bg-neutral-900">
		<slot />
	</body>
</html>
