---
/**
 * An embedded site, filling a window like a browser would.
 *
 * The frame is inert until its window has focus — Window's shield covers it
 * until then, so pointer, wheel and touch events reach the WM and the desktop
 * instead of being swallowed here.
 */
interface Props {
	src: string;
	title: string;
}

const { src, title } = Astro.props;
---

<iframe
	src={src}
	title={title}
	class="h-full w-full border-0 bg-term-bg"
	referrerpolicy="no-referrer-when-downgrade"></iframe>
