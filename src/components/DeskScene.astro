<div class="desk-scene" data-desk-scene aria-hidden="true">
	<div class="desk-scene__loading">LOADING DESK…</div>
</div>

<script>
	import * as THREE from 'three';
	import { GLTFLoader } from 'three/examples/jsm/loaders/GLTFLoader.js';
	import { AsciiEffect } from 'three/examples/jsm/effects/AsciiEffect.js';

	const root = document.querySelector<HTMLElement>('[data-desk-scene]');

	if (root && !root.dataset.ready) {
		root.dataset.ready = 'true';
		const loading = root.querySelector<HTMLElement>('.desk-scene__loading');
		const scene = new THREE.Scene();
		const camera = new THREE.PerspectiveCamera(72, window.innerWidth / window.innerHeight, 0.1, 1000);
		camera.position.set(0.4, 1.45, 6);
		camera.rotation.y = Math.PI / 10;

		const renderer = new THREE.WebGLRenderer({ alpha: true, antialias: false });
		renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.5));
		renderer.setClearColor(0x000000, 0);

		const effect = new AsciiEffect(renderer, ' .,:;+*=%@#asdfzxcv3weq4rpoijb');
		effect.domElement.className = 'desk-scene__ascii';
		effect.domElement.style.color = '#f3f2eb';
		effect.domElement.style.backgroundColor = 'transparent';
		root.append(effect.domElement);

		scene.add(new THREE.HemisphereLight(0xffffdd, 0x080820, 1.4));
		const directionalLight = new THREE.DirectionalLight(0xffffff, 1.5);
		directionalLight.position.set(10, 10, 10);
		scene.add(directionalLight);

		let frame = 0;
		let model: THREE.Object3D | undefined;

		const resize = () => {
			const width = window.innerWidth;
			const height = window.innerHeight;
			camera.aspect = width / height;
			camera.updateProjectionMatrix();
			renderer.setSize(width, height);
			effect.setSize(width, height);
		};

		const updateCamera = () => {
			const progress = Math.min(window.scrollY / Math.max(window.innerHeight * 0.9, 1), 1);
			camera.position.z = 6 - progress * 1.95;
			camera.position.y = 1.45 - progress * 0.15;
			if (model) model.rotation.y = Math.PI + progress * 0.12;
			root.style.opacity = `${Math.max(0, 1 - progress * 1.15)}`;
		};

		const render = () => {
			effect.render(scene, camera);
			frame = requestAnimationFrame(render);
		};

		new GLTFLoader().load(
			'/sidesDesk.glb',
			(gltf) => {
				model = gltf.scene;
				model.rotation.y = Math.PI;
				model.position.z = 10;
				scene.add(model);
				loading?.remove();
				root.classList.add('is-loaded');
			},
			undefined,
			() => {
				if (loading) loading.textContent = 'DESK OFFLINE';
			},
		);

		resize();
		updateCamera();
		render();
		window.addEventListener('resize', resize);
		window.addEventListener('scroll', updateCamera, { passive: true });
		window.addEventListener(
			'pagehide',
			() => {
				cancelAnimationFrame(frame);
				window.removeEventListener('resize', resize);
				window.removeEventListener('scroll', updateCamera);
				renderer.dispose();
				effect.domElement.remove();
			},
			{ once: true },
		);
	}
</script>

<style>
	.desk-scene {
		position: fixed;
		inset: 0;
		z-index: 1;
		overflow: hidden;
		pointer-events: none;
		opacity: 0;
		transition: opacity 0.7s ease;
	}

	.desk-scene.is-loaded {
		opacity: 1;
	}

	.desk-scene :global(.desk-scene__ascii) {
		position: absolute;
		inset: 0;
	}

	.desk-scene__loading {
		position: absolute;
		right: 1.4rem;
		bottom: 1.4rem;
		color: var(--muted);
		font-family: ui-monospace, monospace;
		font-size: 0.68rem;
		letter-spacing: 0.12em;
	}

	@media (max-width: 700px) {
		.desk-scene {
			transform: scale(1.18);
		}
	}
</style>
