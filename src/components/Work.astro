---
/**
 * The work: a banner naming the section, then one window per project, dealt out
 * in a cascade running from the top right down to the bottom left — the way a
 * pile of windows looks before anyone tidies it up. Every step down clears the
 * groupbar of the window behind it, so each title in the pile stays readable.
 *
 * Source order is stacking order — wm.ts hands out z-index in document order —
 * so the pile runs oldest at the back to newest at the front, and clicking a
 * window buried in it raises it, the same as any other window here. It is also
 * the order the windows stack in on a phone, which is why the banner is first.
 */
import Window from './Window.astro';
import Shot from './Shot.astro';
import Terminal from './Terminal.astro';

interface Props {
	/**
	 * Where the cascade starts, in layout boxes. Anything past 1 is the
	 * screenful after the one the desktop opens on.
	 */
	y?: number;
}

const { y: TOP = 1.02 } = Astro.props;

interface Project {
	slug: string;
	name: string;
	blurb: string;
	note?: string;
}

const PROJECTS: Project[] = [
	{
		slug: 'trimech',
		name: 'TriMech',
		blurb: 'Engineering solutions — hardware, software, training and staffing',
		note: 'Pyxl',
	},
	{
		slug: 'mlily',
		name: 'MLILY',
		blurb: 'Sleep brand storefront — mattresses, pillows and adjustable bases',
		note: 'Pyxl',
	},
	{
		slug: 'brownlee',
		name: 'Brownlee',
		blurb: 'Fashion storefront built around seasonal editorial drops',
		note: 'Pyxl · 2022 W3 Gold',
	},
	{
		slug: 'akima',
		name: 'Akima',
		blurb: 'Global enterprise powering critical work across the federal government',
		note: 'Pyxl',
	},
	{
		slug: 'opseyes',
		name: 'Opseyes',
		blurb: 'Wastewater testing service — lab results back in under ten minutes',
		note: 'Pyxl',
	},
	{
		slug: 'razorsync',
		name: 'RazorSync',
		blurb: 'Field service management software, from features through booking a demo',
		note: 'Pyxl',
	},
	{
		slug: 'mergerai',
		name: 'MergerAI',
		blurb: 'AI workspace for M&A diligence and CIM production',
		note: 'founding developer',
	},
];

const W = 0.5;
const H = 0.46;

/**
 * A step has to clear the window behind it: 22px of groupbar plus its 5px gap.
 * The layout box is never shorter than 480px (global.css), and a tenth of the
 * shortest one clears that with room to spare — enough of the screenshot below
 * each title shows to tell the windows apart.
 */
const STEP_Y = 0.1;

/** First window flush with the right edge of the layout box, last with the left. */
const STEP_X = (1 - W) / (PROJECTS.length - 1);

/** Fractions are written into CSS custom properties; keep them short. */
const round = (n: number) => Math.round(n * 1e4) / 1e4;

// figlet, ANSI Shadow — the same font the site's own banner is set in.
const WORK = String.raw`
██╗    ██╗ ██████╗ ██████╗ ██╗  ██╗
██║    ██║██╔═══██╗██╔══██╗██║ ██╔╝
██║ █╗ ██║██║   ██║██████╔╝█████╔╝
██║███╗██║██║   ██║██╔══██╗██╔═██╗
╚███╔███╔╝╚██████╔╝██║  ██║██║  ██╗
 ╚══╝╚══╝  ╚═════╝ ╚═╝  ╚═╝╚═╝  ╚═╝
`.replace(/^\n|\n$/g, '');

/**
 * The banner sits in the column the cascade leaves empty: flush with the left
 * edge, under the blog window, and stopping a gap short of the second window
 * in the pile — a heading is the one window here nothing should overlap.
 *
 * The height holds the prompt, a blank line and six rows of art at the 13px the
 * terminal caps its cell at: ~158px, which a fifth of the layout box only
 * covers on a tall screen. A little over that keeps the banner whole on a phone
 * too, at the cost of some empty terminal below it on a desktop.
 */
const GAP_X = 0.013; // the same sliver the blog and the resume are parted by
const BANNER_W = round(1 - W - STEP_X - GAP_X);
const BANNER_H = 0.21;
---

<Window title="jake@jasi:~/work" x={0} y={round(TOP)} w={BANNER_W} h={BANNER_H}>
	<Terminal cwd="~/work" command="ls" art={WORK} label="Work" cursor={false} />
</Window>

{
	PROJECTS.map((project, i) => (
		<Window x={round(1 - W - i * STEP_X)} y={round(TOP + i * STEP_Y)} w={W} h={H}>
			{/*
				The groupbar is the label: a cascade only leaves the top strip of
				each window showing, so the strip has to say what the window is.
				Unfocused windows dim as a whole rather than through the text
				colour, which is carrying the name/blurb/note hierarchy instead.
			*/}
			<div
				slot="title"
				class="flex min-w-0 items-baseline gap-2 opacity-70 group-data-[focused]:opacity-100"
			>
				<span class="shrink-0 text-fg">{project.name}</span>
				<span class="truncate text-fg-dim">{project.blurb}</span>
				{project.note && <span class="shrink-0 text-accent">{project.note}</span>}
			</div>

			<Shot src={`/work/${project.slug}.webp`} name={project.name} />
		</Window>
	))
}
