---
/**
 * Placement is fractional: x/y/w/h are fractions (0–1) of the layout box, which
 * global.css sizes from the viewport. Nothing here is in pixels, so the
 * arrangement scales instead of being pinned to one screen size — until the
 * user drags or resizes, at which point wm.ts pins that window to pixels.
 *
 * data-title and data-body are handles for windows opened at runtime: spawn.ts
 * clones this chrome out of a <template> and fills those two in.
 */
interface Props {
	/**
	 * What the groupbar reads. Windows whose title is more than a filename pass
	 * the `title` slot instead and style the strip themselves.
	 */
	title?: string;
	x?: number;
	y?: number;
	w?: number;
	h?: number;
	focused?: boolean;
}

const { title = '', x = 0, y = 0, w = 0.5, h = 0.5, focused = false } = Astro.props;
---

<!--
	Window chrome modelled on Hyprland/Omarchy: a 22px groupbar strip floating
	above the frame, separated by gaps_in, and a 2px border that turns accent
	coloured on focus. No rounding, no buttons — same as the tiling WM.
-->
<section
	data-window
	data-focused={focused ? 'true' : undefined}
	style={`--fx: ${x}; --fy: ${y}; --fw: ${w}; --fh: ${h};`}
	class="group absolute top-0 left-0 flex flex-col gap-gap-in"
>
	<header
		data-drag
		class="flex h-groupbar shrink-0 cursor-grab items-center justify-center gap-2 bg-crust/95 px-2 font-mono text-[11px] leading-none text-fg-dim select-none group-data-[focused]:text-fg"
	>
		<slot name="title"><span data-title class="truncate">{title}</span></slot>
	</header>

	<div
		class="relative min-h-0 flex-1 border-2 border-border-idle bg-base shadow-lg shadow-black/40 group-data-[focused]:border-accent"
	>
		<div data-body class="h-full w-full overflow-hidden bg-term-bg">
			<slot />
		</div>

		<!--
			Click-to-focus shield. An embedded frame swallows pointer, wheel and
			touch events, so a window keeps a pane over its contents until it is
			done taking those events for itself: the click reaches the WM, and
			only then does the frame get the pointer. Same bargain a tiling WM
			makes. When the shield comes down is global.css's business — in touch
			mode it is a tap that maximizes, so it waits for that, not for focus.
		-->
		<div data-shield aria-hidden="true" class="absolute inset-0"></div>

		<div data-resize="e" class="absolute top-0 -right-1 h-full w-2 cursor-e-resize"></div>
		<div data-resize="s" class="absolute -bottom-1 left-0 h-2 w-full cursor-s-resize"></div>
		<div data-resize="se" class="absolute -right-1 -bottom-1 z-10 h-3 w-3 cursor-se-resize"></div>
	</div>
</section>
