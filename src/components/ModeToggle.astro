---
// aria-checked mirrors the mode: checked = touch, unchecked = desktop.
---

<button
	id="mode-toggle"
	type="button"
	role="switch"
	aria-checked="true"
	aria-label="Touch mode"
	class="group flex cursor-pointer items-center gap-1.5 font-mono text-[11px] leading-none text-fg-dim select-none"
>
	<span class="group-aria-[checked=false]:text-fg">desktop</span>
	<span class="relative block h-3 w-6 border border-surface1 bg-mantle">
		<span
			class="absolute inset-y-0 left-0 block w-1/2 bg-surface1 transition-transform duration-150 ease-out group-aria-[checked=true]:translate-x-full group-aria-[checked=true]:bg-accent"
		></span>
	</span>
	<span class="group-aria-[checked=true]:text-fg">touch</span>
</button>

<script>
	import { getMode, setMode, onModeChange } from '../scripts/mode';

	const toggle = document.getElementById('mode-toggle');

	if (toggle) {
		const sync = () => toggle.setAttribute('aria-checked', String(getMode() === 'touch'));

		sync();
		onModeChange(sync);
		toggle.addEventListener('click', () => setMode(getMode() === 'touch' ? 'desktop' : 'touch'));
	}
</script>
