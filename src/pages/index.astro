---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Window from '../components/Window.astro';
import ModeToggle from '../components/ModeToggle.astro';
import Terminal from '../components/Terminal.astro';
import Browser from '../components/Browser.astro';
import Pdf from '../components/Pdf.astro';
import Work from '../components/Work.astro';
import wallpaper from '../assets/wallpaper.png';
---

<Layout>
	<main class="relative flex h-screen w-screen flex-col overflow-hidden">
		<!-- Top bar -->
		<div
			class="z-20 grid w-full grid-cols-3 items-center bg-crust px-2 py-1 font-mono text-sm text-fg"
		>
			<span class="justify-self-start text-fg-dim">jasi</span>
			<span id="clock" class="text-center tabular-nums">--:--:--</span>
			<span class="justify-self-end">
				<ModeToggle />
			</span>
		</div>

		<!--
			Desktop. The wallpaper and the stage sit outside #desktop because
			#desktop is the scroller: anything inside it scrolls away, and both
			of these describe the visible area rather than the content.
		-->
		<div id="screen" class="relative flex-1 overflow-hidden [container-type:size]">
			<!--
				The one image on the page that is not lazy: it is the whole
				background, so it is already on screen. astro:assets rewrites the
				2MB source into the widths below, which is most of what the page
				weighs. The width caps the plain src a browser falls back to —
				left off, that is the source's own 4658px, and the largest file
				here by an order of magnitude.
			-->
			<Image
				src={wallpaper}
				alt="Wallpaper of a gradient"
				width={1920}
				widths={[768, 1280, 1920, 2560]}
				sizes="100vw"
				loading="eager"
				fetchpriority="high"
				class="pointer-events-none absolute inset-0 h-full w-full select-none object-cover"
			/>

			<!--
				Invisible container a tapped window maximizes into: the layout
				box itself, gutters included, so it is never edge to edge.
			-->
			<div id="stage" aria-hidden="true" class="pointer-events-none absolute"></div>

			<!--
				Windows keep the positions they were given. A viewport too small
				to hold them scrolls instead of shoving them around.
			-->
			<!--
				Geometry is fractions of the layout box, not pixels: 0.43 is 43% of
				its width, and the gaps between windows are the slivers left over.
				The terminal spans the top; the blog and the resume share the row
				below it in the same 43/56 split they always had. The work
				comes after those, past the bottom of the first layout box — a second
				screenful the desktop scrolls down to.
			-->
			<div id="desktop" class="absolute inset-0 overflow-auto">
				<Window title="jake@jasi:~" x={0} y={0} w={1} h={0.26}>
					<Terminal />
				</Window>
				<Window
					title="blog.jacobsides.com"
					x={0}
					y={0.28}
					w={0.43}
					h={0.72}
					focused
				>
					<Browser src="https://blog.jacobsides.com" title="Jacob Sides' blog" />
				</Window>
				<Window x={0.443} y={0.28} w={0.557} h={0.72}>
					{/*
						The groupbar carries the one action this window has. The PDF is
						shown with `toolbar=0`, so the viewer has no save button of its
						own and the window's chrome is where the copy is taken from —
						the same place a tiling WM keeps everything else about a window.
						data-no-drag keeps the press away from the drag handler, so the
						link is a link and the rest of the strip still drags.
					*/}
					<div slot="title" class="flex min-w-0 items-center gap-3">
						<span class="truncate">resume-jacob-sides.pdf</span>
						<a
							href="/resume-jacob-sides.pdf"
							download
							data-no-drag
							aria-label="Download Jacob Sides' resume"
							class="shrink-0 cursor-pointer text-accent underline underline-offset-2 hover:no-underline"
						>
							download
						</a>
					</div>

					<Pdf src="/resume-jacob-sides.pdf" title="Jacob Sides' resume" />
				</Window>

				<Work />
			</div>

			<!--
				Chrome for windows the shell opens (see spawn.ts). Keeping it here as
				an empty Window rather than as markup in a script is what stops a
				spawned window from drifting away from the ones the page ships with:
				there is still only one description of what a window is.
			-->
			<template id="window-template">
				<Window />
			</template>
		</div>
	</main>
</Layout>

<script>
	import '../scripts/wm.ts';

	const clock = document.getElementById('clock');

	function tick() {
		if (!clock) return;
		clock.textContent = new Date().toLocaleTimeString('en-GB', { hour12: false });
	}

	tick();
	const int = setInterval(tick, 1000);
	document.addEventListener('astro:before-swap', () => clearInterval(int));
</script>
