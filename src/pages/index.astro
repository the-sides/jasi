---
import DeskScene from '../components/DeskScene.astro';
import Experience from '../components/Experience.astro';
import MatrixRain from '../components/MatrixRain.astro';
import WorkGallery from '../components/WorkGallery.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<main>
		<MatrixRain />
		<DeskScene />

		<section class="hero" id="top">
			<nav class="nav shell" aria-label="Primary">
				<a class="nav__mark" href="#top" aria-label="Jacob Sides, home">JS<span>_</span></a>
				<div class="nav__links">
					<a href="#work">Work</a>
					<a href="#experience">Experience</a>
					<a href="/gaming">Gaming</a>
					<a href="mailto:jacob.r.sides@gmail.com">Contact</a>
				</div>
			</nav>

			<div class="hero__content shell" data-hero-copy>
				<h1>Jacob <br />Sides</h1>
				<div class="hero__lower">
					<div>
						<p>Full-stack web developer<br />by experience &amp; skill.</p>
						<p>Creator by ambition<br />&amp; thought.</p>
					</div>
					<div class="hero__contact">
						<a class="email" href="mailto:jacob.r.sides@gmail.com">jacob.r.sides@gmail.com</a>
						<a href="https://github.com/the-sides" target="_blank" rel="noreferrer">GitHub ↗</a>
						<a href="https://www.linkedin.com/in/jacob-sides/" target="_blank" rel="noreferrer"
							>LinkedIn ↗</a
						>
					</div>
				</div>
			</div>

			<a class="scroll-cue" href="#work">
				<span>See work</span>
				<svg viewBox="0 0 24 24" aria-hidden="true">
					<path d="M12 4v15m0 0 6-6m-6 6-6-6"></path>
				</svg>
			</a>
		</section>

		<WorkGallery />
		<Experience />

		<footer class="footer">
			<div class="shell footer__inner">
				<p class="eyebrow">Chattanooga, Tennessee / Internet</p>
				<h2>Let’s make<br />something <em>good.</em></h2>
				<div class="footer__links">
					<a href="mailto:jacob.r.sides@gmail.com">Start a conversation ↗</a>
					<div>
						<a href="https://github.com/the-sides" target="_blank" rel="noreferrer">GitHub</a>
						<a href="https://www.linkedin.com/in/jacob-sides/" target="_blank" rel="noreferrer"
							>LinkedIn</a
						>
						<a href="/old">Old site</a>
					</div>
				</div>
				<p class="footer__fine">Designed &amp; engineered by Jacob Sides · Astro rebuild, 2026</p>
			</div>
		</footer>
	</main>

	<script>
		const heroCopy = document.querySelector<HTMLElement>('[data-hero-copy]');
		const updateHero = () => {
			if (!heroCopy) return;
			const progress = Math.min(window.scrollY / Math.max(window.innerHeight * 0.85, 1), 1);
			heroCopy.style.opacity = `${1 - progress * 1.25}`;
			heroCopy.style.transform = `translateY(${-progress * 32}px)`;
		};
		updateHero();
		window.addEventListener('scroll', updateHero, { passive: true });
	</script>
</Layout>

<style>
	.hero {
		position: relative;
		z-index: 2;
		min-height: 132vh;
		background:
			radial-gradient(circle at 65% 45%, rgba(38, 38, 95, 0.18), transparent 35%),
			transparent;
	}

	.nav {
		position: absolute;
		top: 0;
		left: 50%;
		z-index: 4;
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding-top: 1.3rem;
		transform: translateX(-50%);
	}

	.nav__mark {
		font-family: ui-monospace, monospace;
		font-size: 0.76rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-decoration: none;
	}

	.nav__mark span {
		color: var(--cyan);
		animation: blink 1.1s step-end infinite;
	}

	.nav__links {
		display: flex;
		gap: clamp(1rem, 3vw, 2.6rem);
	}

	.nav__links a {
		color: var(--muted);
		font-size: 0.72rem;
		text-decoration: none;
		transition: color 0.2s ease;
	}

	.nav__links a:hover {
		color: var(--ink);
	}

	.hero__content {
		position: fixed;
		top: 11vh;
		right: 0;
		left: 0;
		z-index: 3;
		pointer-events: none;
		will-change: opacity, transform;
	}

	.hero__content a {
		pointer-events: auto;
	}

	.hero h1 {
		width: auto;
		margin: 0;
		font-family: var(--display);
		font-size: clamp(3.71rem, 10.5vw, 8.4rem);
		font-weight: 700;
		letter-spacing: -0.075em;
		line-height: 0.66;
		white-space: nowrap;
	}

	.hero h1 br {
		display: none;
	}

	.hero__lower {
		display: flex;
		align-items: end;
		justify-content: space-between;
		margin-top: 3.6rem;
	}

	.hero__lower p {
		margin: 0.4rem 0 0;
		color: var(--muted);
		font-size: 1.014rem;
		line-height: 1.2;
		text-shadow: 0 0 0.8rem var(--night), 0 0 0.8rem var(--night);
	}

	.hero__contact {
		display: grid;
		justify-items: end;
		gap: 0.3rem;
		font-size: 1.014rem;
	}

	.hero__contact a {
		background: rgba(11, 11, 26, 0.76);
		box-shadow: 0 0 0.7rem rgba(11, 11, 26, 0.95);
		text-decoration: none;
	}

	.hero__contact .email {
		margin-bottom: 0.5rem;
		font-size: 1.365rem;
	}

	.hero__contact .email:hover {
		animation: shake 0.45s ease;
	}

	.scroll-cue {
		position: absolute;
		bottom: 37vh;
		left: max(20px, calc((100vw - 1180px) / 2));
		z-index: 4;
		display: flex;
		align-items: center;
		gap: 0.7rem;
		color: var(--muted);
		font-family: ui-monospace, monospace;
		font-size: 0.62rem;
		letter-spacing: 0.1em;
		text-decoration: none;
		text-transform: uppercase;
	}

	.scroll-cue svg {
		width: 1.4rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.3;
		animation: dip 1.8s ease-in-out infinite;
	}

	.footer {
		position: relative;
		z-index: 3;
		padding: 8rem 0 2rem;
		background: var(--ink);
		color: var(--night);
	}

	.footer .eyebrow {
		color: #4f5063;
	}

	.footer h2 {
		margin: 1.5rem 0 5rem;
		font-family: var(--display);
		font-size: clamp(4rem, 12vw, 10rem);
		font-weight: 700;
		letter-spacing: -0.075em;
		line-height: 0.72;
	}

	.footer h2 em {
		color: transparent;
		font-style: normal;
		-webkit-text-stroke: 2px var(--night);
	}

	.footer__links {
		display: flex;
		align-items: end;
		justify-content: space-between;
		padding: 2rem 0;
		border-top: 1px solid rgba(11, 11, 26, 0.2);
		border-bottom: 1px solid rgba(11, 11, 26, 0.2);
	}

	.footer__links > a {
		font-family: var(--display);
		font-size: 1.5rem;
		font-weight: 700;
	}

	.footer__links div {
		display: flex;
		gap: 1.5rem;
	}

	.footer__fine {
		margin: 2rem 0 0;
		color: #5c5d6d;
		font-family: ui-monospace, monospace;
		font-size: 0.62rem;
		text-transform: uppercase;
	}

	@keyframes blink {
		50% {
			opacity: 0;
		}
	}

	@keyframes dip {
		50% {
			transform: translateY(0.35rem);
		}
	}

	@keyframes shake {
		25% {
			transform: rotate(3deg);
		}
		75% {
			transform: rotate(-3deg);
		}
	}

	@media (max-width: 700px) {
		.hero {
			min-height: 122vh;
		}

		.nav__links a:nth-child(2),
		.nav__links a:nth-child(3) {
			display: none;
		}

		.hero__content {
			top: 14vh;
		}

		.hero h1 {
			width: min-content;
			font-size: clamp(3.5rem, 17.5vw, 5.6rem);
			line-height: 0.82;
			white-space: normal;
		}

		.hero h1 br {
			display: initial;
		}

		.hero__lower {
			display: grid;
			gap: 2.5rem;
			margin-top: 3rem;
		}

		.hero__contact {
			justify-items: start;
			max-width: 100%;
		}

		.hero__contact .email {
			font-size: 1.235rem;
			overflow-wrap: anywhere;
		}

		.scroll-cue {
			bottom: 28vh;
		}

		.footer__links {
			display: grid;
			gap: 2rem;
		}

		.footer__links div {
			flex-wrap: wrap;
		}
	}
</style>
